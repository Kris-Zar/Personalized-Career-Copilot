# Google Gemini API Key
# Required for live Gemini AI responses (goal extraction, AI tutor)
# If not set, the system uses its built-in deterministic fallback engine
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model — single configuration source for all services
# Use a currently available model from: https://ai.google.dev/models
GEMINI_MODEL=gemini-3.6-flash

# App Configuration
APP_ENV=development
DATA_DIR=data/
